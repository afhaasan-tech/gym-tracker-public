{
  "expo": {
    "name": "VORA",
    "slug": "vora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vora.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.vora.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "VORA uses the microphone only when you record a voice message for your trainer."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VORA opens your photos only when you choose a photo or video to send to your trainer.",
          "cameraPermission": "VORA uses the camera only when you take a photo or video to send to your trainer."
        }
      ],
      "expo-asset"
    ],
    "scheme": "vora",
    "experiments": {
      "typedRoutes": false
    }
  }
}
